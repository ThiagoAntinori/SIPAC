# ==============================================================================
# SITRAC / SIPAC - Configuración de Variables de Entorno
# ==============================================================================

# ── Base de Datos (Supabase PostgreSQL / BASI Fix) ───────────────────────────
# Formato URI directo de Supabase:
DATABASE_URL=postgresql://postgres:[TU-PASSWORD-SUPABASE]@db.[TU-PROYECTO-REF].supabase.co:5432/postgres

# O formato Pooler de Supabase (recomendado si usas modo transacción/sesión):
# DATABASE_URL=postgresql://postgres.[TU-PROYECTO-REF]:[TU-PASSWORD-SUPABASE]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Seguridad y Autenticación JWT ─────────────────────────────────────────────
JWT__SECRET=SITRAC_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG!
JWT__ISSUER=sipac-api
JWT__AUDIENCE=sipac-web
JWT__ACCESSTOKENEXPIRYMINUTES=60
JWT__REFRESHTOKENEXPIRYDAYS=7

# ── Almacenamiento de Comprobantes (Cloudinary) ────────────────────────────────
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# ── Notificaciones de Stock y Alertas ─────────────────────────────────────────
# WhatsApp vía CallMeBot:
NOTIFICATIONS__WHATSAPP__PHONE=
NOTIFICATIONS__WHATSAPP__CALLMEBOTAPIKEY=

# Email SMTP:
NOTIFICATIONS__EMAIL__SMTPHOST=smtp.gmail.com
NOTIFICATIONS__EMAIL__SMTPPORT=587
NOTIFICATIONS__EMAIL__USERNAME=
NOTIFICATIONS__EMAIL__PASSWORD=
NOTIFICATIONS__EMAIL__TO=
