# SIPAC - Variables de Entorno de Ejemplo

# Backend (.NET API) - Configuración alternativa por variables de entorno
# ASPNETCORE_ENVIRONMENT=Development
# ConnectionStrings__SqliteConnection=Data Source=sipac_dev.db
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sipac;Username=postgres;Password=postgres
# Jwt__Secret=TU_CLAVE_SECRETA_JWT_MINIMO_32_CARACTERES
# Cloudinary__CloudName=tu_cloud_name
# Cloudinary__ApiKey=tu_api_key
# Cloudinary__ApiSecret=tu_api_secret

# Frontend (Vite)
# VITE_API_BASE_URL=http://localhost:5225/api
