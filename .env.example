# ==============================================================================
# SITRAC (Sistema Integral de Trabajos y Abastecimiento para Consorcios)
# Configuración de Variables de Entorno
# ==============================================================================

# ── Modo de Base de Datos / Testing ───────────────────────────────────────────
# true  -> Utiliza la base SQLite local clonada ('sitrac_test.db') sin tocar Turso.
# false -> Conecta a la base de datos de producción (Turso / PostgreSQL).
USE_TEST_DB=true

# ── Base de Datos Producción (Turso Cloud / PostgreSQL) ──────────────────────
# Opción 1: Turso Cloud (libSQL)
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Opción 2: PostgreSQL (Supabase / Render)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ── Seguridad y Autenticación JWT ─────────────────────────────────────────────
JWT__SECRET=SITRAC_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG!
JWT__ISSUER=sitrac-api
JWT__AUDIENCE=sitrac-web
JWT__ACCESSTOKENEXPIRYMINUTES=60
JWT__REFRESHTOKENEXPIRYDAYS=7

# ── Almacenamiento de Comprobantes (Cloudinary) ────────────────────────────────
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# ── Notificaciones de Stock y Alertas ─────────────────────────────────────────
# WhatsApp vía CallMeBot:
NOTIFICATIONS__WHATSAPP__PHONE=
NOTIFICATIONS__WHATSAPP__CALLMEBOTAPIKEY=

# Email SMTP:
# Email Transaccional (Resend - Recomendado para Render y Producción):
RESEND_API_KEY=
RESEND_FROM=SITRAC <onboarding@resend.dev>

# Email SMTP (Gmail / Clásico - Fallback local):
NOTIFICATIONS__EMAIL__SMTPHOST=smtp.gmail.com
NOTIFICATIONS__EMAIL__SMTPPORT=587
NOTIFICATIONS__EMAIL__USERNAME=
NOTIFICATIONS__EMAIL__PASSWORD=
NOTIFICATIONS__EMAIL__TO=

# ── Configuración Web Push (VAPID) ───────────────────────────────────────────
VAPID__SUBJECT=mailto:soporte@sitrac.com
VAPID__PUBLIC_KEY=
VAPID__PRIVATE_KEY=
APP_URL=http://localhost:5173
